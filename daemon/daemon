#!/bin/bash
# LoxBerry Init Daemon script for smtp2mqtt
# Executed at boot time by LoxBerry init system

if [ -f /etc/environment ]; then
    . /etc/environment
fi

LB_HOME="${LBHOMEDIR:-$HOME}"
PLUGIN_DIR="${LBPBIN:-$LB_HOME/bin/plugins}/smtp2mqtt"
DAEMON="$PLUGIN_DIR/smtp2mqtt.py"

if [ ! -f "$DAEMON" ]; then
    DAEMON="$PLUGIN_DIR/bin/smtp2mqtt.py"
fi

start_daemon() {
    pkill -f "smtp2mqtt.py" 2>/dev/null || true
    sleep 1
    if [ "$(id -un 2>/dev/null)" = "loxberry" ]; then
        nohup python3 "$DAEMON" > /dev/null 2>&1 &
    elif command -v runuser >/dev/null 2>&1; then
        runuser -u loxberry -- nohup python3 "$DAEMON" > /dev/null 2>&1 &
    elif id -u loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "nohup python3 '$DAEMON' > /dev/null 2>&1 &"
    else
        nohup python3 "$DAEMON" > /dev/null 2>&1 &
    fi
}

case "$1" in
    start)
        echo "<INFO> Starting smtp2mqtt daemon..."
        if [ -f "$DAEMON" ]; then
            start_daemon
            echo "<OK> smtp2mqtt daemon started successfully."
        else
            echo "<ERROR> Daemon executable not found at $DAEMON"
            exit 1
        fi
        ;;
    stop)
        echo "<INFO> Stopping smtp2mqtt daemon..."
        pkill -f "smtp2mqtt.py" 2>/dev/null || true
        echo "<OK> smtp2mqtt daemon stopped."
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        if pgrep -f "smtp2mqtt.py" > /dev/null; then
            echo "<OK> smtp2mqtt is running."
            exit 0
        else
            echo "<WARNING> smtp2mqtt is not running."
            exit 1
        fi
        ;;
    *)
        $0 start
        ;;
esac

exit 0
